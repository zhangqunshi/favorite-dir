{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "常用目录",
  "version": "1.0.0",
  "identifier": "com.favorite-dir.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "常用目录",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "visible": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^.*$"
    }
  }
}
